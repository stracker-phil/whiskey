{
  "name": "stracker-phil/whiskey",
  "description": "WordPress configuration recipes demonstrating PHP 7.4 to 8.3 evolution",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "~9.6.0",
    "php-stubs/wp-cli-stubs": "^2.10",
    "phpmetrics/phpmetrics": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "Whiskey\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Whiskey\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "XDEBUG_MODE=coverage phpunit --coverage-html coverage/ --coverage-clover coverage/coverage.xml",
    "coverage": "XDEBUG_MODE=coverage phpunit --coverage-text"
  }
}
